    'Тайвшрах',
    'Сөрөг мэдрэмжээ гадагшлуулах',
    'Анхаарлаа сарниулах',
    'Эрч хүч авах',
    'Дурсамж сэргээх',
    'Ажил, хичээлд төвлөрөх',
  ]);

  gate('3.6. Найзууд ба нууцлал', 'Апп дээр найз нэмсэн үү?');
  mc(form, 'Сэтгэл санааны бүртгэлээ хэнтэй хуваалцдаг вэ?', [
