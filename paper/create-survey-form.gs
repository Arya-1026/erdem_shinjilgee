  gate('3.1. Сэтгэл санааны бүртгэл', 'Өдөр тутмын сэтгэл санааны бүртгэл хийсэн үү?');
  grid(form, 'Сэтгэл санааны бүртгэлийн талаар', [
    'Мэдрэмжээ нэрлэж бүртгэх нь өөрийн сэтгэл хөдлөлийг илүү сайн ойлгоход тусалсан',
    'Бүртгэлийн түүх, графикаас өөрийн сэтгэл санааны хэв маягийг (ямар өдөр, ямар шалтгаанаар) анзаарсан',
