  const gatePages = form.getItems(FormApp.ItemType.PAGE_BREAK).map((p) => p.asPageBreakItem());
  gates.forEach((g, i) => {
    const after = nextGatePage(gatePages, g.detail, gates, i, sus);
    links.push(() =>
      g.item.setChoices([
        g.item.createChoice('Тийм', g.detail),
        g.item.createChoice('Үгүй', after),
      ])
    );
  });

  // ---------- 5. Мэдрэгдсэн үр нөлөө ----------
  page(form, '5. Мэдрэгдсэн үр нөлөө');
  grid(form, 'Энэ апп нь…', [
    '…өөрийн сэтгэл санаа, сэтгэл зүйн байдлын талаарх мэдлэгийг минь нэмэгдүүлсэн',
    '…сэтгэцийн эрүүл мэндийн талаарх ойлголтыг минь нэмэгдүүлсэн',
    '…сэтгэл санаагаа хянах, зохицуулах хандлагыг минь эерэгээр өөрчилсөн',
    '…сэтгэл санаагаа зохицуулахын тулд ямар нэг зүйл хийх хүслийг минь нэмэгдүүлсэн',
    '…хэрэгтэй үед мэргэжлийн тусламж авах магадлалыг минь нэмэгдүүлсэн',
    '…өдөр тутмын зан үйлд минь (нойр, дасгал, амралт г.м.) эерэг өөрчлөлт авчирсан',
  ]);
  mc(form, 'Аппыг ашиглаж эхэлснээс хойш ерөнхий сэтгэл санаа тань:', [
    'Илүү муудсан',
    'Бага зэрэг муудсан',
    'Өөрчлөгдөөгүй',
    'Бага зэрэг сайжирсан',
    'Илүү сайжирсан',
  ]);
  form
    .addScaleItem()
    .setTitle('Энэ аппыг найз, танилдаа санал болгох магадлал хэр вэ?')
    .setBounds(0, 10)
    .setLabels('Огт санал болгохгүй', 'Заавал санал болгоно')
    .setRequired(true);

  // ---------- 6. Итгэл ----------
  page(form, '6. Аюулгүй байдал ба итгэл');
  grid(form, 'Нууцлал, аюулгүй байдлын талаар', [
    'Миний хувийн мэдээлэл, бүртгэл нууцлагдана гэдэгт итгэдэг',
    'Энэ апп мэргэжлийн эмчилгээг орлохгүй гэдгийг ойлгосон',
    'Хүнд үед апп яаралтай тусламжийн утсыг (103, 108) харуулдгийг мэддэг',
    'Апп миний мэдээллийг зөвшөөрөлгүйгээр бусадтай хуваалцахгүй гэдэгт итгэлтэй байна',
  ]);
  mc(form, 'Апп хэзээ нэгэн цагт танд эвгүй, хор хөнөөлтэй санагдсан тохиолдол гарсан уу?', YES_NO);
  form.addParagraphTextItem().setTitle('«Тийм» бол тайлбарлана уу');

  // ---------- 7. Үнэ ----------
  page(form, '7. Үнэ төлбөр');
  mc(form, 'Premium багцыг (хязгааргүй AI чат, дэлгэрэнгүй тайлан, хөгжмийн бүрэн сан) сард хэдэн төгрөгөөр авах вэ?', [
    'Авахгүй, үнэгүй хувилбар хангалттай',
    '5,000₮ хүртэл',
    '5,000–9,900₮',
    '9,900–15,000₮',
    '15,000₮-өөс дээш',
  ]);
  mc(form, 'Нэг удаагийн онлайн сэтгэл зүйн зөвлөгөөнд хэдэн төгрөг төлөхөд бэлэн бэ?', [
    'Төлөхгүй',
    '20,000₮ хүртэл',
    '20,000–35,000₮',
    '35,000–50,000₮',
    '50,000₮-өөс дээш',
  ]);

  // ---------- 8. Нээлттэй асуулт ----------
  page(form, '8. Таны санал', 'Хариулах заавал биш.');
  form.addParagraphTextItem().setTitle('Аппын хамгийн хэрэгтэй санагдсан функц юу вэ, яагаад?');
  form.addParagraphTextItem().setTitle('Хамгийн дургүй, төвөгтэй санагдсан зүйл юу вэ?');
  form.addParagraphTextItem().setTitle('Сэтгэл зүйн тусламж авахад танд юу хамгийн их саад болдог вэ? Апп үүнийг хэрхэн бууруулж чадах вэ?');
  form.addParagraphTextItem().setTitle('Нэмэх, сайжруулах санал');

  links.forEach((fn) => fn());

  try {
    if (form.setPublished) form.setPublished(true);
  } catch (e) {
    Logger.log('setPublished: ' + e);
  }
  form.setAcceptingResponses(true);

  Logger.log('Засах холбоос: ' + form.getEditUrl());
  Logger.log('Бөглөх холбоос: ' + form.getPublishedUrl());
}

// Тухайн нээх асуултын «Үгүй» хариулт очих хуудас: дараагийн функцын нээх хуудас.
// 3.6-ийн дараа 3.7 (нээх асуултгүй) хуудас ирнэ, 3.9-ийн дараа SUS.
function nextGatePage(pages, detail, gates, i, sus) {
  const idx = pages.findIndex((p) => p.getId() === detail.getId());
  const next = pages[idx + 1];
  return next || sus;
}

function page(form, title, help) {
  const p = form.addPageBreakItem().setTitle(title);
  if (help) p.setHelpText(help);
  return p;
}

function mc(form, title, choices, other) {
  const item = form.addMultipleChoiceItem().setTitle(title).setRequired(true);
  if (choices) item.setChoiceValues(choices);
  if (other) item.showOtherOption(true);
  return item;
}

function cb(form, title, choices, other) {
  const item = form.addCheckboxItem().setTitle(title).setChoiceValues(choices).setRequired(true);
  if (other) item.showOtherOption(true);
  return item;
}

function grid(form, title, rows, columns) {
  return form
    .addGridItem()
    .setTitle(title)
    .setRows(rows)
    .setColumns(columns || LIKERT)
    .setRequired(true);
}
