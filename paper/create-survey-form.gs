    'Ярианы төгсгөлд хийж болох бодит алхам санал болгосон',
    'Чатны хариулт ойлгомжтой, монгол хэл нь зөв байсан',
    'Чатны хариулт заримдаа хэт ерөнхий, механик санагдсан',
    'Миний бичсэн зүйлийг нууцлах талаар санаа зовсон',
  ]);

  gate(
    '3.4. Дасгал, киноны зөвлөмж',
    'Санал болгосон дасгал, киноны зөвлөмжийг ашигласан уу?',
    'Дасгал: амьсгал, сунгалт, 3D дасгал г.м.'
  );
  grid(form, 'Зөвлөмжийн талаар', [
    'Зөвлөмж миний тухайн үеийн сэтгэл санаанд тохирсон байсан',
    'Дасгал хийсний дараа сэтгэл санаа тайвширсан',
    'Дасгалын заавар (3D дүр, алхам алхмаар) ойлгомжтой байсан',
