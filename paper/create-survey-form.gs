    'Үр дүнгээ хараад мэргэжилтэнд хандах тухай бодсон',
    'Тестийг давтан бөглөж, өөрчлөлтөө харах нь хэрэгтэй',
    'Үр дүнгээ сэтгэл зүйчтэй ярилцахад ашиглахад бэлэн байна',
  ]);

  gate('3.3. AI чат', 'AI чат ашигласан уу?');
  grid(form, 'AI чатын талаар', [
    'Хүн биш AI-тай ярих нь асуудлаа ичихгүйгээр, нээлттэй хэлэхэд хялбар байсан',
