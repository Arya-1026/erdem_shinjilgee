# Энэ файлыг .env.local нэрээр хуулж, утгуудаа бөглөнө. .env.local-ийг git-д бүү оруул.
# CRON_SECRET, VAPID түлхүүрүүдийг `npm run keys` командаар үүсгэнэ.

# --- Апп-ын хаяг. Spotify "localhost"-ийг зөвшөөрдөггүй тул локалд 127.0.0.1 ашиглана ---
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# --- Supabase (Project Settings → API Keys) [ЗААВАЛ] ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Зөвхөн сервер дээр: cron, бүртгэл устгахад. Клиент рүү ХЭЗЭЭ Ч бүү гарга.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Spotify: дууны санал, хайлт, тоглуулалт [ЗААВАЛ]. Апп эзэмшигч Premium байх ёстой ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- LLM: Groq (үндсэн), OpenRouter (нөөц). Чат, дууны mood ангилал, хүн бүрт тохирсон дууны саналд ---
# Аль аль нь байхгүй бол чат дүрэмд суурилсан, дууны ангилал түлхүүр үгэнд суурилна
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# --- Crisis шүүлтүүр: OpenAI Moderation (үнэгүй). Байхгүй бол зөвхөн түлхүүр үгээр шүүнэ ---
OPENAI_API_KEY=

# --- Имэйл: Resend. Байхгүй бол имэйлийг зөвхөн log-д бичнэ ---
RESEND_API_KEY=
EMAIL_FROM="Сэтгэл <onboarding@resend.dev>"

# --- Push мэдэгдэл (Web Push, VAPID). npm run keys ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- pg_cron → /api/cron/reminders хүсэлтийг баталгаажуулах нууц (npm run keys) ---
CRON_SECRET=
